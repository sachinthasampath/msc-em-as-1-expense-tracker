EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# OPENROUTER_API_KEY and OPENROUTER_MODEL are server-only secrets.
